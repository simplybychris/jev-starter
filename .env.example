# Copy this file to .env and paste your OpenRouter key.
# .env never goes into git or into the Docker image.

# Key from https://openrouter.ai/settings/keys (set a credit limit on it, e.g. 5 USD).
OPENROUTER_API_KEY=

# Jev model on OpenRouter.
JEV_MODEL=jev-1.13

# Port of the API server (locally and inside the container).
PORT=3000

# Daily Jev spending limit in USD. Once it is used up, the server answers 402 until midnight.
DAILY_BUDGET_USD=1

# How many /api requests per minute one IP address may send.
RATE_LIMIT_PER_MINUTE=60

# Maximum size of one /api request body (e.g. 100kb, 1mb).
BODY_LIMIT=100kb

# Time zone: the daily spending counter resets at midnight in this zone (e.g. Europe/Warsaw).
TZ=UTC

# Server only: a unique app name (lowercase letters, digits, dashes).
# It becomes the container name that Caddy forwards traffic to.
# APP_NAME=my-app
