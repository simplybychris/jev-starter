# Skopiuj ten plik jako .env i wklej swój klucz OpenRouter.
# Plik .env nigdy nie trafia do gita ani do obrazu Dockera.

# Klucz z https://openrouter.ai/settings/keys (ustaw na nim limit kredytów, np. 5 USD).
OPENROUTER_API_KEY=

# Model Jev na OpenRouterze.
JEV_MODEL=jev-1.13

# Port serwera API (lokalnie i w kontenerze).
PORT=3000

# Dzienny limit wydatków na Jev w USD. Po jego przekroczeniu serwer odpowiada kodem 402 do północy.
DAILY_BUDGET_USD=1

# Ile zapytań do /api na minutę może wysłać jeden adres IP.
RATE_LIMIT_PER_MINUTE=60

# Tylko na serwerze: unikalna nazwa aplikacji (małe litery, cyfry, myślniki).
# Z niej powstaje nazwa kontenera, na którą Caddy przekierowuje ruch.
# APP_NAME=moja-aplikacja
